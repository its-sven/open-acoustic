// Settings of the unit-test target (hosted in the app, so WKWebView and CoreMIDI run for real).
PRODUCT_NAME = OpenAcousticTests
PRODUCT_BUNDLE_IDENTIFIER = $(OA_BUNDLE_ID).tests
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
TARGETED_DEVICE_FAMILY = 1,2
GENERATE_INFOPLIST_FILE = YES
SWIFT_EMIT_LOC_STRINGS = NO
// XCTest itself needs iOS 17
IPHONEOS_DEPLOYMENT_TARGET = 17.0
TEST_HOST = $(BUILT_PRODUCTS_DIR)/OpenAcoustic.app/$(BUNDLE_EXECUTABLE_FOLDER_PATH)/OpenAcoustic
BUNDLE_LOADER = $(TEST_HOST)
