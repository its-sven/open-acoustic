// Copy to Local.xcconfig (git-ignored) and fill in. Never commit Local.xcconfig.
//
// Your team ID: Xcode ▸ Settings ▸ Accounts ▸ your Apple ID ▸ the "Personal Team" row
// (or developer.apple.com ▸ Membership). It is a 10-character code like ABCDE12345.
DEVELOPMENT_TEAM = ABCDE12345

// With a free Apple ID the bundle identifier must be unique to you. Use your own reverse domain,
// e.g. your GitHub user name:
// OA_BUNDLE_ID = io.github.<your-github-user>.openacoustic
